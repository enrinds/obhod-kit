<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VPN"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/vpnStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="sing-box: не запущен  ·  socks 10808: закрыт  ·  TUN: лежит"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Ключи: по одной ссылке на строку, либо один JSON (sing-box или Xray)."
            android:textSize="13sp" />

        <EditText
            android:id="@+id/vpnKeys"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="top|start"
            android:hint="vless://…"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minLines="6"
            android:maxLines="12"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/vpnPaste"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Вставить" />

            <Button
                android:id="@+id/vpnSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Сохранить" />
        </LinearLayout>

        <Button
            android:id="@+id/vpnConnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Подключить" />

        <Button
            android:id="@+id/vpnDisconnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Отключить" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Лог sing-box"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/vpnLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:minLines="4"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
